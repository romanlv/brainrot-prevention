<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- debug only: testOnly so `dpm remove-active-admin` works and only `adb install -t` installs it -->
    <application android:testOnly="true">
        <receiver
            android:name="dev.brainrotprevention.debug.DebugControlReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="dev.brainrotprevention.debug.CONTROL" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
